#!/bin/bash
# {{ ansible_managed }}
#
# Weekly /etc/portal archive → age-encrypted → s3://<bucket>/config/.
#
# Most of /etc/portal re-renders from the vault on any converge — but
# /etc/portal/agent-ca (the gameserver CA private key, when the MatchZy
# integration is enabled) exists NOWHERE else: losing it means re-enrolling
# every game server. This is its offsite copy.
#
# Runs as root (agent-ca and the env files are root-owned). Config from
# /etc/portal/backup.env.

set -euo pipefail

BACKUP_DIR=/var/lib/portal-backups
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
NAME="etc-portal_${STAMP}.tar.zst"
OUT="$BACKUP_DIR/$NAME"

# node_exporter textfile collector (observability-design.md §4.7). The dir
# only exists once roles/monitoring has run — skip silently otherwise so
# backups never depend on the monitoring stack.
TEXTFILE_DIR=/var/lib/node_exporter/textfile
START_TS=$(date +%s)
emit_backup_metrics() { # <job> <size-bytes>
    [ -d "$TEXTFILE_DIR" ] || return 0
    local now
    now=$(date +%s)
    {
        echo "portal_backup_last_success_timestamp_seconds{job=\"$1\"} $now"
        echo "portal_backup_last_size_bytes{job=\"$1\"} $2"
        echo "portal_backup_last_duration_seconds{job=\"$1\"} $((now - START_TS))"
    } > "$TEXTFILE_DIR/portal-backup-$1.prom.tmp"
    # Atomic rename — node_exporter reads the directory concurrently.
    mv "$TEXTFILE_DIR/portal-backup-$1.prom.tmp" "$TEXTFILE_DIR/portal-backup-$1.prom"
}

mkdir -p "$BACKUP_DIR"

echo "→ archiving /etc/portal → $OUT"
tar -C /etc -cf - portal | zstd -T0 -q -o "$OUT"
chmod 0600 "$OUT"   # env secrets inside — root-only, unlike the pg dumps

zstd -t -q "$OUT"
(cd "$BACKUP_DIR" && sha256sum "$NAME" > "$NAME.sha256")
chmod 0600 "$OUT.sha256"

echo "→ encrypting for upload"
age -r "$BACKUP_AGE_PUBLIC_KEY" -o "$OUT.age" "$OUT"

echo "→ uploading to s3://${BACKUP_BUCKET}/config/"
aws --endpoint-url="$AWS_ENDPOINT_URL" \
    s3 cp "$OUT.age" "s3://${BACKUP_BUCKET}/config/${NAME}.age" --only-show-errors
aws --endpoint-url="$AWS_ENDPOINT_URL" \
    s3 cp "$OUT.sha256" "s3://${BACKUP_BUCKET}/config/${NAME}.sha256" --only-show-errors
rm -f "$OUT.age"

echo "→ pruning local config archives older than ${BACKUP_LOCAL_RETENTION_DAYS} days"
find "$BACKUP_DIR" -maxdepth 1 -type f \
    \( -name 'etc-portal_*.tar.zst' -o -name 'etc-portal_*.tar.zst.sha256' \) \
    -mtime "+${BACKUP_LOCAL_RETENTION_DAYS}" -delete

emit_backup_metrics config-backup "$(stat -c%s "$OUT")"

echo "✓ config backup complete"
