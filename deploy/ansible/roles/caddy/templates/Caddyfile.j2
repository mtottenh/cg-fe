# {{ ansible_managed }}

{
    email {{ caddy_acme_email }}
    # Structured logs to journald — no separate log files to rotate.
    log {
        output stderr
        format json
    }
}

{{ portal_domain }} {
    encode zstd gzip

    # API routes — everything the backend owns.
    @api {
        path /v1/* /uploads/* /swagger-ui/* /api-docs/* /health
    }
    handle @api {
        reverse_proxy 127.0.0.1:3000 {
            # Pass client identity through.
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote}
            # 60s is plenty; bump if you add long-polling routes.
            transport http {
                read_timeout 60s
                write_timeout 60s
            }
        }
    }

    # Frontend SPA. Fallback to index.html for client-side routing.
    handle {
        root * /var/www/portal
        try_files {path} /index.html
        file_server
    }

    # HSTS + sensible defaults.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server

        # Content-Security-Policy for the Vite-built Vue/Vuetify SPA served
        # same-origin with its API. Access and refresh tokens live in
        # localStorage, so any injected script can exfiltrate a 7-day session
        # — this is the main mitigation until the refresh token moves to an
        # HttpOnly cookie.
        #
        #   default-src 'self'      deny-by-default for anything not listed
        #   script-src 'self'       strict: Vite emits hashed external JS only,
        #                           no inline <script> and no eval, so no
        #                           'unsafe-inline'/'unsafe-eval' is needed.
        #                           If this ever breaks, fix the build — do not
        #                           relax it.
        #   style-src 'unsafe-inline'  Vuetify injects runtime <style> blocks
        #                           and inline style attributes for its theme
        #                           and layout; CSS injection is far lower risk
        #                           than script injection.
        #   img-src data: blob:     inlined small assets + client-generated
        #                           object URLs (avatar/banner previews); the
        #                           object-storage origin is where uploaded
        #                           avatars/banners/screenshots actually live
        #                           (S3_EVIDENCE_PUBLIC_URL in api.env).
        #   font-src data:          MDI/webfont files, some inlined by Vite.
        #   connect-src wss:        API calls are same-origin; wss: covers the
        #                           lobby/veto WebSocket. Object storage is
        #                           listed too for direct presigned PUT/GET.
        #   frame-ancestors 'none'  clickjacking, mirrors X-Frame-Options DENY
        #   base-uri/form-action 'self'  block <base> hijacking and off-site
        #                           form posts.
        #   object-src 'none'       no Flash/applet/plugin surface.
        #
        # NOTE: this also applies to /swagger-ui/*, which Caddy proxies from
        # the API under this same domain. Swagger UI bootstraps from an inline
        # <script>, so 'script-src self' breaks it — intentional in prod. If
        # you need Swagger UI on the public host, move it to its own site
        # block rather than weakening script-src here.
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {{ portal_evidence_public_url }}; font-src 'self' data:; connect-src 'self' wss: {{ portal_evidence_public_url }}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
    }
}

# Demo-stats service (CS2 demo parser). The portal API's SSRF guard requires
# CS2_DEMO_SERVICE_URL to be https + non-private, so the loopback service is
# fronted here. Needs a DNS A record for demos.{{ portal_domain }} pointing
# at this box.
demos.{{ portal_domain }} {
    encode zstd gzip

    reverse_proxy 127.0.0.1:{{ demo_stats_port | default(3100) }} {
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
        # Demo parsing of a large .dem can take a while.
        transport http {
            read_timeout 300s
            write_timeout 300s
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        -Server
    }
}
