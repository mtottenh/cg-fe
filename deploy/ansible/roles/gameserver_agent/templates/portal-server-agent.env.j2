# {{ ansible_managed }}
# /etc/portal/portal-server-agent.env — hand edits are overwritten on the
# next converge.

# Outbound mTLS WebSocket to the portal (Caddy client_auth vhost).
PORTAL_AGENT_URL=wss://agents.{{ portal_domain }}/v1/gameserver/agent/ws

# Material written by enrollment (roles/gameserver_agent runs it).
PORTAL_AGENT_CERT=/etc/portal/agent/client.pem
PORTAL_AGENT_KEY=/etc/portal/agent/client.key
PORTAL_AGENT_CA=/etc/portal/agent/portal-ca.pem

# Local CS2 server RCON (requires -usercon on the server command line).
RCON_ADDR={{ gameserver_rcon_addr }}
RCON_PASSWORD={{ vault_gameserver_rcon_passwords[inventory_hostname] }}

# The portal marks servers offline after 90s of silence — keep <=60.
PORTAL_AGENT_HEARTBEAT_SECS={{ gameserver_heartbeat_secs }}

{% if gameserver_metrics_addr | default('') | length > 0 %}
# Loopback Prometheus /metrics for THIS host's operator (the portal never
# scrapes game hosts — observability-design.md §4.6).
METRICS_ADDR={{ gameserver_metrics_addr }}
{% endif %}

RUST_LOG=info
