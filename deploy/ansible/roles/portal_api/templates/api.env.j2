# {{ ansible_managed }}
# /etc/portal/api.env — hand edits are overwritten on the next deploy.

DATABASE_URL={{ portal_api_database_url }}
JWT_SECRET={{ vault_jwt_secret }}

PORT=3000
PORTAL_CORS_ORIGINS={{ portal_cors_origins }}

# Public URLs — REQUIRED for Steam OpenID sign-in. Without these the backend
# falls back to http://localhost:3000 / :5173 and Steam login redirects every
# user to localhost. The frontend is served same-origin by Caddy, so both
# point at the portal domain.
PORTAL_PUBLIC_URL=https://{{ portal_domain }}
PORTAL_FRONTEND_URL=https://{{ portal_domain }}

# Steam Web API key (persona/avatar enrichment on sign-in).
STEAM_API_KEY={{ vault_steam_api_key }}

# CS2 demo parser. Must be https + non-private (SSRF guard) — this is the
# Caddy-fronted demo-stats service, not localhost.
CS2_DEMO_SERVICE_URL={{ cs2_demo_service_url }}

ACCESS_TOKEN_EXPIRY_MINUTES={{ portal_access_token_expiry_minutes }}
REFRESH_TOKEN_EXPIRY_MINUTES={{ portal_refresh_token_expiry_minutes }}

EVIDENCE_STORAGE=s3
S3_EVIDENCE_BUCKET={{ portal_evidence_bucket }}
S3_EVIDENCE_REGION={{ linode_object_storage_region }}
S3_EVIDENCE_PUBLIC_URL={{ portal_evidence_public_url }}
S3_EVIDENCE_ENDPOINT={{ linode_object_storage_endpoint }}

AWS_ACCESS_KEY_ID={{ vault_linode_access_key }}
AWS_SECRET_ACCESS_KEY={{ vault_linode_secret_key }}

RUST_LOG=portal=info,tower_http=info,sqlx=warn
