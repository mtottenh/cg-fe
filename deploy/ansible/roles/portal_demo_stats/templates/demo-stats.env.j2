# Rendered by Ansible — do not edit on the host.
DEMO_STATS_PORT={{ demo_stats_port | default(3100) }}
DEMO_STATS_DATA_DIR=/var/lib/portal-demo-stats
DEMO_STATS_SCAN_INTERVAL_SECS={{ demo_stats_scan_interval | default(60) }}
# S3 source (same bucket the scanner catalogs from). Leave bucket empty to
# use local-directory mode only.
DEMO_STATS_S3_BUCKET={{ demo_stats_s3_bucket | default('') }}
DEMO_STATS_S3_ENDPOINT={{ demo_stats_s3_endpoint | default('https://gb-lon-1.linodeobjects.com') }}
DEMO_STATS_S3_REGION={{ demo_stats_s3_region | default('gb-lon-1') }}
DEMO_STATS_S3_PREFIX={{ demo_stats_s3_prefix | default('') }}
AWS_ACCESS_KEY_ID={{ vault_demo_stats_s3_access_key | default('') }}
AWS_SECRET_ACCESS_KEY={{ vault_demo_stats_s3_secret_key | default('') }}
