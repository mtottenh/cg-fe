# Rendered by Ansible — do not edit on the host.
DEMO_STATS_PORT={{ demo_stats_port | default(3100) }}
DEMO_STATS_DATA_DIR=/var/lib/portal-demo-stats
DEMO_STATS_SCAN_INTERVAL_SECS={{ demo_stats_scan_interval | default(60) }}
# S3 source (same bucket the scanner catalogs from). Leave bucket empty to
# use local-directory mode only. Defaults follow the shared Object Storage
# settings in group_vars/all/vars.yml; the credentials default to the
# vault_linode_* pair (override with vault_demo_stats_s3_* for a tighter
# blast radius).
DEMO_STATS_S3_BUCKET={{ demo_stats_s3_bucket | default(portal_demos_bucket) }}
DEMO_STATS_S3_ENDPOINT={{ demo_stats_s3_endpoint | default(linode_object_storage_endpoint) }}
DEMO_STATS_S3_REGION={{ demo_stats_s3_region | default(linode_object_storage_region) }}
DEMO_STATS_S3_PREFIX={{ demo_stats_s3_prefix | default('') }}
AWS_ACCESS_KEY_ID={{ vault_demo_stats_s3_access_key | default(vault_linode_access_key) }}
AWS_SECRET_ACCESS_KEY={{ vault_demo_stats_s3_secret_key | default(vault_linode_secret_key) }}
{% if monitoring_enabled | default(false) %}
# Loopback Prometheus exporter (observability-design.md §3). Never public,
# never through Caddy. Empty/unset = disabled.
METRICS_ADDR=127.0.0.1:{{ monitoring_metrics_ports['portal-demo-stats'] }}
{% endif %}
