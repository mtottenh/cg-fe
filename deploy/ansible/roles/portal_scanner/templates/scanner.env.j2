# {{ ansible_managed }}
# /etc/portal/scanner.env — hand edits are overwritten on the next deploy.

# Portal API this scanner registers demos with (co-hosted → loopback).
PORTAL_API_URL=http://127.0.0.1:3000
PORTAL_API_KEY={{ vault_portal_scanner_api_key }}

# Game the cataloged demos belong to (UUID from the games table).
SCANNER_GAME_ID={{ scanner_game_id }}

# Linode Object Storage source bucket for .dem files.
SCANNER_S3_BUCKET={{ portal_demos_bucket }}
SCANNER_S3_ENDPOINT={{ linode_object_storage_endpoint }}
SCANNER_S3_REGION={{ linode_object_storage_region }}
SCANNER_S3_PREFIX={{ scanner_s3_prefix | default('') }}
AWS_ACCESS_KEY_ID={{ vault_scanner_s3_access_key | default(vault_linode_access_key) }}
AWS_SECRET_ACCESS_KEY={{ vault_scanner_s3_secret_key | default(vault_linode_secret_key) }}

# Demo parser the scanner fetches stats from (Caddy-fronted demo-stats).
CS2_DEMO_SERVICE_URL={{ cs2_demo_service_url }}

SCANNER_INTERVAL_SECS={{ scanner_interval_secs | default(300) }}
SCANNER_PROCESSING_INTERVAL_SECS={{ scanner_processing_interval_secs | default(60) }}

{% if monitoring_enabled | default(false) %}
# Loopback Prometheus exporter (observability-design.md §3). Never public,
# never through Caddy. Empty/unset = disabled.
METRICS_ADDR=127.0.0.1:{{ monitoring_metrics_ports['portal-scanner'] }}
{% endif %}

RUST_LOG=portal_scanner=info
