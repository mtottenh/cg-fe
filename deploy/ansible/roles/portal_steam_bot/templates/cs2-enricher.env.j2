# {{ ansible_managed }}
# /etc/portal/cs2-enricher.env — hand edits are overwritten on the next deploy.

# Portal API this bot authenticates to (co-hosted → loopback). Note /v1.
PORTAL_API_URL=http://127.0.0.1:3000/v1
PORTAL_API_KEY={{ vault_steam_bot_api_key }}

# Dedicated Steam bot account (Game Coordinator login).
STEAM_USERNAME={{ vault_steam_bot_username }}
STEAM_PASSWORD={{ vault_steam_bot_password }}
STEAM_SHARED_SECRET={{ vault_steam_bot_shared_secret }}

BATCH_SIZE={{ steam_bot_enrich_batch_size | default(5) }}
ENRICH_INTERVAL_SECS={{ steam_bot_enrich_interval_secs | default(30) }}
GAME_SLUG={{ steam_bot_game_slug | default('cs2') }}
SKIP_DEMO_RANK={{ steam_bot_skip_demo_rank | default(false) | string | lower }}

{% if monitoring_enabled | default(false) %}
# Loopback Prometheus exporter + /healthz (observability-design.md §3/§4.5).
# Never public, never through Caddy. Empty/unset = disabled.
METRICS_ADDR=127.0.0.1:{{ monitoring_metrics_ports['cs2-enricher'] }}
{% endif %}

# Loopback Steam Guard code-entry page: consulted when STEAM_SHARED_SECRET
# is empty and the stored machine token can't satisfy a login. Ingress is
# Tailscale Serve on ts.net:{{ steam_bot_guard_serve_port }} (tailnet mode)
# or an SSH tunnel; never public, never through Caddy.
GUARD_ADDR=127.0.0.1:{{ steam_bot_guard_port }}

RUST_LOG=cs2_enricher=info
