# {{ ansible_managed }}
# /etc/portal/cs2-poller.env — hand edits are overwritten on the next deploy.

# Portal API this bot authenticates to (co-hosted → loopback). Note /v1.
PORTAL_API_URL=http://127.0.0.1:3000/v1
PORTAL_API_KEY={{ vault_steam_bot_api_key }}

# Steam Web API key (reuses the portal's key — same Web API credential).
STEAM_WEB_API_KEY={{ vault_steam_api_key }}

POLL_INTERVAL_SECS={{ steam_bot_poll_interval_secs | default(60) }}
GAME_SLUG={{ steam_bot_game_slug | default('cs2') }}

{% if monitoring_enabled | default(false) %}
# Loopback Prometheus exporter + /healthz (observability-design.md §3/§4.4).
# Never public, never through Caddy. Empty/unset = disabled.
METRICS_ADDR=127.0.0.1:{{ monitoring_metrics_ports['cs2-poller'] }}
{% endif %}

RUST_LOG=cs2_poller=info
