# Top-level ops commands. Run `just` to list.
#
# Convention: anything that touches the live box goes through SSH or
# ansible-playbook so everything is auditable in shell history.

set dotenv-load := false
set shell := ["bash", "-euo", "pipefail", "-c"]

# --- config pulled from the Ansible inventory so we don't repeat ourselves
HOST := `yq -r '.all.hosts[].ansible_host' ansible/inventory/prod.yml 2>/dev/null || echo portal`
USER := "ops"

default:
    @just --list

# Install Galaxy roles + collections (linode.cloud, community.postgresql, ...).
galaxy:
    ansible-galaxy install -r ansible/requirements.yml
    ansible-galaxy collection install -r ansible/requirements.yml

# Provision a fresh Ubuntu 26.04 LTS Linode and point inventory/prod.yml at
# it. Needs `export LINODE_TOKEN=...` (https://cloud.linode.com/profile/tokens).
provision:
    #!/usr/bin/env bash
    set -euo pipefail
    : "${LINODE_TOKEN:?export LINODE_TOKEN=<personal access token> first}"
    ansible-playbook ansible/provision.yml

# First converge against a freshly provisioned box: only root has an SSH key
# until roles/base creates the ops user, so override ansible_user once.
bootstrap-fresh:
    ansible-playbook -i ansible/inventory/prod.yml ansible/site.yml --ask-vault-pass -e ansible_user=root

# Idempotent full site play. Run after editing Ansible, or monthly.
bootstrap:
    ansible-playbook -i ansible/inventory/prod.yml ansible/site.yml --ask-vault-pass

# Deploy a tagged release. Downloads debs from the matching GitHub release
# and hands them to the playbook via -e overrides.
#
# Usage: just deploy v0.2.1
deploy VERSION:
    #!/usr/bin/env bash
    set -euo pipefail
    tmp=$(mktemp -d)
    echo "→ downloading portal-api + portal-scanner {{VERSION}} → $tmp"
    gh release download {{VERSION}} --repo community-gaming/gaming-portal \
        --pattern 'portal-api_*_amd64.deb' \
        --pattern 'portal-scanner_*_amd64.deb' \
        --dir "$tmp"
    ls -la "$tmp"
    ansible-playbook -i ansible/inventory/prod.yml ansible/site.yml \
        --ask-vault-pass \
        --tags portal_api,portal_scanner \
        -e portal_api_deb_path="$tmp/$(ls "$tmp" | grep ^portal-api_)" \
        -e portal_scanner_deb_path="$tmp/$(ls "$tmp" | grep ^portal-scanner_)"
    rm -rf "$tmp"

# Build the SPA locally (npm ci && npm run build, same-origin VITE_API_URL)
# and ship web/dist to /var/www/portal. See roles/portal_web.
deploy-web:
    ansible-playbook -i ansible/inventory/prod.yml ansible/site.yml \
        --ask-vault-pass --tags portal_web

# Install/refresh the demo-stats service from a locally built deb
# (built in the sibling demo-stats-service repo).
#
# Usage: just deploy-demo-stats ../demo-stats-service/target/debian/portal-demo-stats_0.1.0_amd64.deb
deploy-demo-stats DEB:
    ansible-playbook -i ansible/inventory/prod.yml ansible/site.yml \
        --ask-vault-pass --tags portal_demo_stats \
        -e portal_demo_stats_deb_path={{DEB}}

# Install/refresh the Steam bots (cs2-poller + cs2-enricher) from a locally
# built deb. Build first in the sibling steam_bot workspace:
#   cargo build --release -p cs2-poller -p cs2-enricher \
#     && cargo deb -p cs2-enricher --no-build
#
# Usage: just deploy-steam-bot ../steam_bot/target/debian/portal-steam-bot_0.1.0_amd64.deb
deploy-steam-bot DEB:
    ansible-playbook -i ansible/inventory/prod.yml ansible/site.yml \
        --ask-vault-pass --tags portal_steam_bot \
        -e portal_steam_bot_enabled=true \
        -e portal_steam_bot_deb_path={{DEB}}

# Convenience: follow the live API log.
logs:
    ssh {{USER}}@{{HOST}} -t 'journalctl -fu portal-api'

# Last 200 warn/error lines across all portal units.
tail-errors:
    ssh {{USER}}@{{HOST}} "journalctl -u 'portal-*' -p warning -n 200 --no-pager"

# systemctl status for every portal unit, plus postgres.
status:
    ssh {{USER}}@{{HOST}} "systemctl status --no-pager portal-api postgresql caddy portal-scanner portal-demo-stats cs2-poller cs2-enricher 2>&1 | head -240"

# psql shell into the prod DB over SSH (no port forwarded, no password on
# the network — socket auth on the box).
db-shell:
    ssh {{USER}}@{{HOST}} -t "sudo -u portal psql -d portal_prod"

# Kick a backup immediately, outside of the timer's schedule. Useful
# before a risky migration or deploy.
backup-now:
    ssh {{USER}}@{{HOST}} 'sudo systemctl start pg-backup.service'
    ssh {{USER}}@{{HOST}} 'sudo journalctl -u pg-backup.service -n 50 --no-pager'

# Edit the vault in-place. Needs the vault password.
edit-vault:
    ansible-vault edit ansible/group_vars/all/vault.yml

ssh:
    ssh {{USER}}@{{HOST}}

# Sanity: check what versions are actually installed on the box.
installed:
    ssh {{USER}}@{{HOST}} "dpkg -l | awk '/portal-|^ii  caddy|^ii  postgresql/ {print \$2, \$3}'"
